# Server-only. Never put this value in index.html or browser storage.
OPENAI_API_KEY=
WEAVER_MODEL=gpt-5.6-luna

# Default: fail_closed. Set only with client authorization; the bypass is embedded
# visibly in run logs, manifests, health output, and generated scraper.py files.
WEAVER_ROBOTS_POLICY=fail_closed

# Weaver blocks localhost and private-network targets by default.
WEAVER_ALLOW_PRIVATE_NETWORKS=false
WEAVER_DATA_DIR=./data
WEAVER_MAX_BATCH_URLS=10
WEAVER_MAX_CONCURRENT_RUNS=2
WEAVER_MAX_PENDING_RUNS=20
WEAVER_MAX_RESPONSE_BYTES=8000000

# Trusted origin used for absolute social-preview metadata.
WEAVER_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Optional bearer token for non-local API clients. Keep it server-side; health
# remains public for Docker healthchecks. Runtime failure callbacks use their
# own one-run capability token.
WEAVER_API_TOKEN=
# Required for the AutoPosting server-to-server vehicle handoff. Configure the
# same 32+ character signing secret used by AutoPosting to mint the short-lived
# origin/policy attestation. The value is never persisted in run artifacts.
WEAVER_AUTH_ATTESTATION_SECRET=
# Optional Cloudflare Access service token for customer-owned vehicle runs.
# Global values are safe only for one dedicated exact origin. Multi-tenant
# AutoPosting deployments should use signed per-run organization credentials.
WEAVER_CF_ACCESS_ORIGIN=
WEAVER_CF_ACCESS_CLIENT_ID=
WEAVER_CF_ACCESS_CLIENT_SECRET=

# Optional comma-separated portal origins allowed to read the API in a browser.
# Example: https://portal.example.com,https://staging.example.com
WEAVER_CORS_ORIGINS=

# Required for the AutoPosting background-sync rollout (`docker compose
# --profile autoposting up -d`). This secret must match AutoPosting's server-side
# SCRAPER_WORKER_SECRET. It never belongs in the Chrome extension.
AUTOPOSTING_REAPER_BASE_URL=https://www.autopostingpro.com
AUTOPOSTING_REAPER_SECRET=
AUTOPOSTING_REAPER_INTERVAL_SECONDS=30
